    },
    "condition": {
      "type": "origins:in_block",
      "block_condition": {
        "type": "origins:block",
        "block": "lava"
      }
    }
  },

  "swim": {
    "type": "origins:swimming",
    "condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:submerged_in",
          "fluid": "lava"
        },
        {
          "type": "origins:in_block_anywhere",
          "comparison": ">=",
          "compare_to": 1,
          "block_condition": {
            "type": "origins:fluid",
            "fluid_condition": {
              "type": "origins:in_tag",
              "tag": "minecraft:lava"
            }
          }
        }
      ]
    }
  }
