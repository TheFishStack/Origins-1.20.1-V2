          "command": "playsound minecraft:entity.strider.eat master @a ~ ~ ~ 1 0"
        },
        {
          "type": "origins:change_resource",
          "resource": "fairy:mana_resource",
          "change": 50
        }
      ]
    },
    "cooldown": 20,
    "hud_render": {
      "should_render": false
    },
    "key": {
      "key": "key.use",
      "continuous": false
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:equipped_item",
          "equipment_slot": "mainhand",
          "item_condition": {
            "type": "origins:ingredient",
            "ingredient": {
              "item": "minecraft:glistering_melon_slice"
            }
          }
        },
        {
          "type": "origins:sneaking",
          "inverted": true
        }
      ]
    }
