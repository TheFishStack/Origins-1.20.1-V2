{
  "name": "Mana",
  "description": "Mana fills up over time or by using glistering melons. You can use your mana for necromancy although i dont think they want to be raised..",
  "type": "origins:multiple",

  "resource": {
    "type": "origins:resource",
    "min": 0,
    "max": 200,
    "hud_render": {
