{
  "name": "Small but agile",
  "description": "You are smaller but faster and posses the ability to fly with your wings",
  "type": "origins:multiple",

  "height": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "scale set pehkui:base 0.5 @s"
    },
    "interval": 200
  },

  "glide": {
    "type": "origins:elytra_flight",
    "render_elytra": true
  },

  "boost": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:add_velocity",
      "z": 0.7,
      "space": "local",
      "set": true
    },
    "interval": 5,
    "condition": {
      "type": "origins:fall_flying"
    }
  },

  "particle": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "particle minecraft:dust 1 0 1 0.5 ~ ~ ~ 0 0 0 0.5 2 force"
    },
    "interval": 1,
    "condition": {
      "type": "origins:fall_flying"
    }
  },

  "noelytra": {
    "type": "origins:restrict_armor",
    "chest": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:elytra"
      }
    }
  },

  "faster": {
    "type": "origins:attribute",
    "modifier": {
      "attribute": "minecraft:generic.movement_speed",
      "operation": "addition",
      "value": 0.05
    }
  }
}
