{
  "name": "Mark",
  "description": "Shift rightclick to mark a player or villager",
  "type": "origins:action_on_entity_use",
  "bientity_action": {
    "type": "origins:target_action",
    "action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "tag @e remove fs_wizard_marker"
        },
        {
          "type": "origins:execute_command",
          "command": "tag @s add fs_wizard_marker"
        },
        {
          "type": "origins:execute_command",
          "command": "tellraw @a {\"text\": \"Entity Marked!\", \"color\": \"white\"}"
        }
      ]
    }
  },
  "bientity_condition": {
    "type": "origins:target_condition",
    "condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:entity_type",
          "entity_type": "minecraft:player"
        },
        {
          "type": "origins:entity_type",
          "entity_type": "minecraft:villager"
        }
      ]
    }
  },
  "item_condition": {
    "type": "origins:empty"
  },
  "hands": ["main_hand"],
  "condition": {
    "type": "origins:sneaking"
  }
}
